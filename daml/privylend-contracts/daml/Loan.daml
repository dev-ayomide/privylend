module Loan where

import Collateral
import DA.Time

-- Loan request with LTV validation
template LoanRequest
  with
    borrower : Party
    lendingPool : Party
    collateralId : Text
    collateralCid : ContractId CollateralAccount
    requestedAsset : Text      -- "USDC", "USDT", "cBTC"
    requestedAmount : Decimal
    collateralValue : Decimal
    interestRate : Decimal     -- Annual rate (0.08 = 8%)
    status : Text              -- "Pending" | "Approved" | "Rejected"
  where
    signatory borrower
    observer lendingPool

    -- Critical: Validate LTV <= 70%
    let loanToValue = requestedAmount / collateralValue
    ensure loanToValue <= 0.70

    choice RejectLoan : ()
      controller lendingPool
      do
        -- Reject the loan request (archives it)
        -- Borrower must cancel to unlock their collateral
        return ()

    choice CancelRequest : ContractId CollateralAccount
      controller borrower
      do
        -- Borrower cancels their own request and unlocks collateral
        exercise collateralCid UnlockCollateral

    choice ApproveLoan : ContractId ActiveLoan
      controller lendingPool
      do
        -- Note: Collateral is locked by borrower before requesting loan
        -- Pool cannot interact with borrower's collateral (Daml privacy model)
        currentTime <- getTime
        create ActiveLoan with
          borrower = borrower
          lender = lendingPool
          collateralId = collateralId
          collateralCid = collateralCid
          loanAsset = requestedAsset
          principal = requestedAmount
          outstandingBalance = requestedAmount
          collateralValue = collateralValue
          currentLTV = loanToValue
          interestRate = interestRate
          startDate = currentTime
          dueDate = addRelTime currentTime (days 30)
          status = "Active"
          marginCallThreshold = 0.80
          liquidationThreshold = 0.85

-- Active loan with risk monitoring
template ActiveLoan
  with
    borrower : Party
    lender : Party
    collateralId : Text
    collateralCid : ContractId CollateralAccount
    loanAsset : Text
    principal : Decimal
    outstandingBalance : Decimal
    collateralValue : Decimal
    currentLTV : Decimal
    interestRate : Decimal
    startDate : Time
    dueDate : Time
    status : Text              -- "Active" | "MarginCall" | "Liquidating" | "Repaid"
    marginCallThreshold : Decimal
    liquidationThreshold : Decimal
  where
    signatory borrower, lender

    choice UpdateCollateralValue : ContractId ActiveLoan
      with
        newCollateralValue : Decimal
      controller lender
      do
        let newLTV = outstandingBalance / newCollateralValue
        let newStatus =
              if newLTV >= liquidationThreshold then "Liquidating"
              else if newLTV >= marginCallThreshold then "MarginCall"
              else "Active"

        create this with
          collateralValue = newCollateralValue
          currentLTV = newLTV
          status = newStatus

    choice MakePayment : ContractId ActiveLoan
      with
        paymentAmount : Decimal
      controller borrower
      do
        -- Calculate accrued interest based on time elapsed
        currentTime <- getTime
        let timeDiff = subTime currentTime startDate
        let microseconds = intToDecimal (convertRelTimeToMicroseconds timeDiff)
        let daysElapsed = microseconds / 86400000000.0  -- microseconds per day
        let accruedInterest = principal * interestRate * (daysElapsed / 365.0)
        let totalOwed = outstandingBalance + accruedInterest

        -- Enforce minimum payment covers at least accrued interest
        assertMsg "Payment must be positive" (paymentAmount > 0.0)

        let newBalance = totalOwed - paymentAmount

        if newBalance <= 0.0
          then do
            -- Loan fully repaid - unlock collateral
            unlockedCid <- exercise collateralCid UnlockCollateral
            create this with
              outstandingBalance = 0.0
              status = "Repaid"
              collateralCid = unlockedCid
          else do
            -- Partial payment - update balance and LTV
            let newLTV = newBalance / collateralValue
            let newStatus =
                  if newLTV >= liquidationThreshold then "Liquidating"
                  else if newLTV >= marginCallThreshold then "MarginCall"
                  else "Active"

            create this with
              outstandingBalance = newBalance
              currentLTV = newLTV
              status = newStatus

    choice TriggerLiquidation : ContractId ActiveLoan
      controller lender
      do
        assertMsg "LTV not at threshold" (currentLTV >= liquidationThreshold)

        -- Mark loan as liquidated
        -- Note: Collateral seizure requires separate workflow with borrower
        -- The locked collateral cannot be withdrawn by the borrower
        create this with
          status = "Liquidated"
          outstandingBalance = 0.0
